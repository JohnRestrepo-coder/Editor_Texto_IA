{
  "name": "ai-document-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI Document Studio - Editor de texto enriquecido con asistencia de IA",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "uvicorn backend.app.main:app --reload --port 8000",
    "lint:backend": ".\\.venv\\Scripts\\ruff check backend",
    "format:backend": ".\\.venv\\Scripts\\ruff format backend",
    "test:backend": ".\\.venv\\Scripts\\pytest -v backend/tests",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "ci:local": "npm run build:frontend && npm run lint:backend && npm run test:backend"
  },
  "keywords": [
    "tiptap",
    "fastapi",
    "spec-kit",
    "ai-document-editor"
  ],
  "author": "John Restrepo",
  "license": "MIT"
}
