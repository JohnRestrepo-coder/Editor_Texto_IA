{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-document-studio.local/schemas/template.schema.json",
  "title": "Template",
  "type": "object",
  "required": [
    "id",
    "name",
    "source_type",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "native",
        "docx"
      ]
    },
    "source_file_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "default": "es"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "position",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean"
          },
          "instructions": {
            "type": "string"
          },
          "generation_enabled": {
            "type": "boolean",
            "default": true
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "style_profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
